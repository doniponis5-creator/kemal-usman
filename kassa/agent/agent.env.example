# Программа кассы на ПК магазина. Скопируйте в agent.env и заполните (agent.env в git не попадает).
# Адрес сервера кассы и его секрет (тот же, что KASSA_1C_SECRET на сервере).
KASSA_URL=https://kassa.kemalusman.kg
KASSA_1C_SECRET=
# База 1С Kemal Usman и пользователь 1С, от имени которого проводятся продажи.
ONEC_BASE=D:\doonni\1С Предприятие\Базы\Kemal Usman база
ONEC_USER=
ONEC_PASSWORD=
# Магазины = склады 1С через «;». Кассы по умолчанию: «Касса <склад>» (наличные) и «Перевод <склад>» (перевод).
KASSA_SHOPS=Kemal Usman Parfume;Kemal Usman Parfume Osh
