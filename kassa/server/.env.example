# Скопировать в .env на сервере. Секреты сюда вписывает скрипт выкладки (этап 4) или владелец — не в чат.
KASSA_1C_SECRET=
KASSA_SHOP_TITLE=Kemal Usman Parfume
KASSA_SELLER=Kemal Usman Parfume
KASSA_PUBLIC_URL=https://kassa.kemalusman.kg
# Бонусы клуба (этап 3): PocketBase сайта и ключ — тот же, что в pb_data/kassa_credentials.json на сервере PocketBase.
KASSA_CLUB_URL=https://api.kemalusman.kg
KASSA_CLUB_KEY=
# WhatsApp — Green API Kemal (тот же номер, что у сайта: GREEN_API_INSTANCE / GREEN_API_TOKEN). Пусто — пробный режим.
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
