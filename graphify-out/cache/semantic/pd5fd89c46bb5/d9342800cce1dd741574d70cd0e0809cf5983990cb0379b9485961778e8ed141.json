{"nodes": [{"id": "migration_guide", "label": "Migration Guide: demo to production", "file_type": "document", "source_file": "MIGRATION_GUIDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered, individually reversible steps (est. 4-6h) to move the shop from a demo setup with client-side secrets to a production backend."}, {"id": "migration_guide_pb_admin_password_rotation", "label": "Leaked PocketBase admin password rotation", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PocketBase admin password was committed to git history; deleting script files does not remove it, so rotation must happen before any other step."}, {"id": "migration_guide_https_backend_caddy", "label": "HTTPS backend via Caddy + Let's Encrypt (api.kemalusman.kg)", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend was plaintext HTTP on a raw IP; Caddy terminates TLS with an auto-issued Let's Encrypt cert so iOS ATS and the web client can require HTTPS."}, {"id": "migration_guide_pb_rules_lockdown", "label": "PocketBase rules lockdown (replaces pb-open-all.js)", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only products are publicly listable (admin-write-only); clients and orders return 401 to anonymous callers."}, {"id": "migration_guide_legacy_pb_scripts", "label": "Legacy leaked-secret PB scripts (pb-setup, pb-fix-rules, pb-open-all)", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Superseded by scripts/pb-secure-rules.js and removed because they embedded admin credentials and opened all collection rules."}, {"id": "migration_guide_pb_hooks_deploy", "label": "Deploy PocketBase server-side hooks (pb_hooks)", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PocketBase auto-loads *.pb.js under pb_hooks/; an OTP request with an empty phone returning 400 proves hooks are running."}, {"id": "migration_guide_otp_auth_migration", "label": "Switch LoginScreen to OTP auth (requestOtp/verifyOtp)", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old name+phone flow issues no real auth token, so the new orders.listRule returns 401 by design; this forces the OTP migration before shipping."}, {"id": "migration_guide_server_side_admin_login", "label": "Move admin login server-side (adminLogin)", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin password was compared client-side from settings; moving to PocketBase admin auth keeps it bcrypt-hashed server-side and out of the client bundle (required before App Store submission)."}, {"id": "migration_guide_i18n_gradual_migration", "label": "Gradual screen-by-screen i18n migration to react-i18next", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy TRANSLATIONS/LangContext and react-i18next coexist so one screen can migrate per day without breaking others; a custom ESLint rule blocks new hardcoded Cyrillic strings."}, {"id": "migration_guide_server_side_bonus_math", "label": "Move bonus / order math to the server", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PB hooks validate orders, recompute totals and credit/debit bonuses, making the server the source of truth; client localStorage bonus balance and setBonusBalance mutations become redundant."}, {"id": "migration_guide_rollback_plan", "label": "Migration roll-back plan", "file_type": "concept", "source_file": "MIGRATION_GUIDE.md", "source_location": "L218", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every step is reversible (stop Caddy to fall back to HTTP in pb.js, delete hooks, keep old LoginScreen, partial i18n is fine, delete client bonus logic last)."}], "edges": [{"source": "migration_guide", "target": "migration_guide_pb_admin_password_rotation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MIGRATION_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "migration_guide", "target": "migration_guide_https_backend_caddy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MIGRATION_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "migration_guide", "target": "migration_guide_pb_rules_lockdown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MIGRATION_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "migration_guide", "target": "migration_guide_pb_hooks_deploy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MIGRATION_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "migration_guide", "target": "migration_guide_otp_auth_migration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MIGRATION_GUIDE.md", "source_location": null, "weight": 1.0},