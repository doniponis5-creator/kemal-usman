{"nodes": [{"id": "security_fix_readme", "label": "Security fixes deploy guide (P0/P1/P2, 2026-06-10)", "file_type": "document", "source_file": "SECURITY_FIX_README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uzbek-language runbook for shipping payment/auth/admin security fixes to the server in a strict order."}, {"id": "security_fix_readme_webhook_signature_mandatory", "label": "O!Dengi payment webhook: mandatory hash verification", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The webhook previously accepted unsigned requests and could mark orders paid; missing/bad hash now returns 403."}, {"id": "security_fix_readme_webhook_amount_check", "label": "Webhook amount (tiyin) + currency matched against order", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_odengi_creds_server_env", "label": "O!Dengi merchant credentials read from server env only", "file_type": "rationale", "source_file": "SECURITY_FIX_README.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The merchant SID/password were hardcoded and leaked via git, so they are now read only from ODENGI_SID/ODENGI_PASSWORD in the PocketBase env file and the merchant password must be rotated."}, {"id": "security_fix_readme_settings_secret_removal", "label": "Remove payment secrets from public settings collection", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_debug_endpoints_removed", "label": "Debug endpoints removed from production (debug_odengi, debug_variant)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_payment_endpoint_auth", "label": "Payment endpoints require PB token + order ownership", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_fail_closed_payments", "label": "Fail-closed online payments (503 payment_not_configured)", "file_type": "rationale", "source_file": "SECURITY_FIX_README.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If O!Dengi env vars are missing, online payment is disabled rather than risking money; cash keeps working."}, {"id": "security_fix_readme_otp_camelcase_fix", "label": "OTP hook v2: camelCase fields (referral system fix)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "otp.pb.js wrote snake_case fields while the schema is camelCase, breaking referrals; bonuses now credit only on first delivery per main.pb.js design."}, {"id": "security_fix_readme_crypto_random_otp", "label": "Crypto-random OTP codes ($security, not Math.random)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_admin_token_gating", "label": "Admin panel gated by real admin token (no #admin/localStorage bypass)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also stops remembering the admin password in localStorage; only the email is remembered."}, {"id": "security_fix_readme_whatsapp_server_hook", "label": "WhatsApp sending via server hook (Green API token server-only)", "file_type": "rationale", "source_file": "SECURITY_FIX_README.md", "source_location": "L175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Green API token was readable in the admin JS chunk; sending (including sendFileByUrl images) moved to a server hook with a 20 msgs / 10 min per-user rate limit, and the token must be rotated."}, {"id": "security_fix_readme_admin_settings_sync", "label": "Admin settings synced to PocketBase (1.2s debounce, merge on load)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L176", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings lived only in localStorage so server hooks (bonus %, delivery) and other devices never saw them; hooks now fall back to the first settings record if id='main' is missing."}, {"id": "security_fix_readme_i18n_consolidation", "label": "i18n consolidated into strings-ru.json / strings-kg.json (203/203 keys)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_productcard_memo", "label": "ProductCard memoization (100+ catalog cards)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_money_logic_tests", "label": "Money-logic integration tests (8 tests: price tamper, bonus overflow, debit, welcome dup)", "file_type": "concept", "source_file": "SECURITY_FIX_README.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_fix_readme_security_acceptance_test